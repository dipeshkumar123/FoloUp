NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_LIVE_URL=localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Retell AI
RETELL_API_KEY=

# ---------------------------------------------------------------------------
# LLM provider (Groq by default, OpenAI as fallback)
# ---------------------------------------------------------------------------
# Get a free key at https://console.groq.com/keys — Groq runs GPT-OSS and
# Llama models at hundreds of tokens per second with a generous free tier.
# The same `openai` Node SDK is used (Groq is OpenAI-API-compatible).
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides:
#   LLM_BACKEND=openai  -> force OpenAI even when GROQ_API_KEY is set
#   LLM_MODEL=openai/gpt-oss-20b  -> pick a specific model
#
# Default Groq model: openai/gpt-oss-120b (production). If that 404s
# (e.g. Groq retires it), the client walks down an automatic fallback
# chain: gpt-oss-120b -> gpt-oss-20b -> qwen3.6-27b -> llama-3.1-*.
# Health check: GET /api/llm-health
#LLM_BACKEND=
#LLM_MODEL=
